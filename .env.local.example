# Supabase - Copy to .env.local and fill in values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: parent domain for clearing Supabase auth cookies on sign-out
# AUTH_COOKIE_DOMAIN=

# Required for Admin Invite API (Users) - NEVER expose to client
SUPABASE_SERVICE_ROLE_KEY=

# Required for client_viewer campaign creation email alerts
RESEND_API_KEY=
CAMPAIGN_ALERT_EMAIL_FROM=CRM Dashboard <noreply@yourdomain.com>

# MSG91 WhatsApp (server only — get values from MSG91 control panel)
WHATSAPP_MSG91_AUTH_KEY=
WHATSAPP_MSG91_INTEGRATED_NUMBER=
WHATSAPP_MSG91_NAMESPACE=
WHATSAPP_MSG91_LANGUAGE_CODE=en
WHATSAPP_MSG91_LANGUAGE_POLICY=deterministic
WHATSAPP_MSG91_CHAT_TEMPLATE=feedback_support_message
WHATSAPP_MSG91_BOOKING_TEMPLATE=
